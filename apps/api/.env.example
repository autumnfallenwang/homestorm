# Postgres (scripts/db-start.sh runs a local postgres:17-alpine on 127.0.0.1:5433)
DATABASE_URL=postgresql://homestorm:homestorm@localhost:5433/homestorm_dev

# HTTP server port (local dev)
API_PORT=3001

# CORS: comma-separated origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# The home LLM gateway. Every model call goes through it (ADR 0002).
LLMGW_URL=http://llmgw.arch.internal

# Most tokens one seat's view may use per turn (ADR 0012)
VIEW_TOKEN_BUDGET=120000

# Login sessions (ADR 0011): required; the API refuses to start without it.
# Any long random string for local dev: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-dev-only-change-me-0123456789abcdef
# Leave COOKIE_DOMAIN unset locally (a .arch.internal cookie is dropped on localhost).

# Integration tests (*.integration.test.ts) run against this database, never DATABASE_URL: they truncate tables.
# Created and migrated automatically by src/test/global-setup.ts. Unset, integration tests skip.
TEST_DATABASE_URL=postgresql://homestorm:homestorm@localhost:5433/homestorm_test
