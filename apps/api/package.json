{
  "name": "@homestorm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.live.test.ts'",
    "test:live": "vitest run src/**/*.live.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "reset-password": "tsx --env-file=.env src/scripts/reset-password.ts"
  },
  "dependencies": {
    "@homestorm/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/client": "2.4.0",
    "better-auth": "1.4.19",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.14",
    "hono-rate-limiter": "0.5.3",
    "image-size": "2.0.4",
    "openai": "^7.47.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
